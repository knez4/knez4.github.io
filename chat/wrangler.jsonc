{
  // The portfolio chat. Deployed on its own with `npx wrangler deploy` from this folder;
  // the site itself stays on GitHub Pages and only calls this over HTTPS.
  "name": "veljko-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  // Per visitor (keyed by IP): at most 6 questions a minute.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
